{
  "expo": {
    "name": "Ganu Denu",
    "slug": "ganu-denu",
    "version": "12.0.0",    "orientation": "portrait",
            "icon": "./assets/GanuDenu AppIcon.png",
    "scheme": "ganudenu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#4C1D95",
    "description": "Sinhala money manager for Sri Lankan families. Track income & expenses with Sinhala UI.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sismath.ganudenu",
      "buildNumber": "12",      "infoPlist": {
        "NSCameraUsageDescription": "Scan bills and receipts to track expenses",
        "NSPhotoLibraryUsageDescription": "Select receipt photos to track expenses",
        "NSFaceIDUsageDescription": "Unlock app with Face ID",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
                  "foregroundImage": "./assets/GanuDenu AppIcon.png",
        "backgroundColor": "#4C1D95"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sismath.ganudenu",
      "versionCode": 12,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4C1D95"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Ganu Denu with Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b10626a7-72ab-404b-8fdb-8505816ace84"
      },
      "router": {}
    },
    "owner": "kamfa2907"
  }
}
